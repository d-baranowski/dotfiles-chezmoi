{
  "activity_cleanup_interval_min": 60,
  "activity_max_records": 100000,
  "activity_max_response_size": 65536,
  "activity_max_size_mb": 256,
  "activity_retention_days": 90,
  "allow_server_add": true,
  "allow_server_remove": true,
  "api_key": "{{ .mcpproxy_api_key }}",
  "call_tool_timeout": "2m0s",
  "check_server_repo": true,
  "code_execution_pool_size": 10,
  "code_execution_timeout_ms": 120000,
  "data_dir": "{{ .chezmoi.homeDir }}/.mcpproxy",
  "debug_search": false,
  "disable_management": false,
  "docker_isolation": {
    "enabled": false,
    "enable_cache_volume": true,
    "default_images": {
      "bash": "alpine:3.18",
      "binary": "alpine:3.18",
      "cargo": "rust:1.75-slim",
      "composer": "php:8.2-cli-alpine",
      "gem": "ruby:3.2-alpine",
      "go": "golang:1.21-alpine",
      "node": "node:20",
      "npm": "node:20",
      "npx": "node:20",
      "php": "php:8.2-cli-alpine",
      "pip": "python:3.11",
      "pipx": "python:3.11",
      "python": "python:3.11",
      "python3": "python:3.11",
      "ruby": "ruby:3.2-alpine",
      "rustc": "rust:1.75-slim",
      "sh": "alpine:3.18",
      "uvx": "python:3.11",
      "yarn": "node:20"
    },
    "registry": "docker.io",
    "network_mode": "bridge",
    "memory_limit": "512m",
    "cpu_limit": "1.0",
    "timeout": "30s",
    "log_max_size": "100m",
    "log_max_files": "3"
  },
  "enable_code_execution": false,
  "enable_prompts": true,
  "enable_socket": true,
  "environment": {
    "inherit_system_safe": true,
    "allowed_system_vars": [
      "PATH",
      "HOME",
      "TMPDIR",
      "TEMP",
      "TMP",
      "SHELL",
      "TERM",
      "LANG",
      "USER",
      "USERNAME",
      "XDG_CONFIG_HOME",
      "XDG_DATA_HOME",
      "XDG_CACHE_HOME",
      "XDG_RUNTIME_DIR",
      "LC_ALL",
      "LC_CTYPE",
      "LC_NUMERIC",
      "LC_TIME",
      "LC_COLLATE",
      "LC_MONETARY",
      "LC_MESSAGES",
      "LC_PAPER",
      "LC_NAME",
      "LC_ADDRESS",
      "LC_TELEPHONE",
      "LC_MEASUREMENT",
      "LC_IDENTIFICATION"
    ],
    "custom_vars": {
      "PATH": "{{ .chezmoi.homeDir }}/.asdf/shims:{{ .chezmoi.homeDir }}/go/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
    },
    "enhance_path": true
  },
  "intent_declaration": {
    "strict_server_validation": true
  },
  "listen": "127.0.0.1:18420",
  "logging": {
    "level": "info",
    "enable_file": true,
    "enable_console": false,
    "filename": "main.log",
    "max_size": 10,
    "max_backups": 5,
    "max_age": 30,
    "compress": true,
    "json_format": false
  },
  "max_result_size_chars": 500000,
  "mcpServers": [
